# Copy to .env (gitignored) or export these before running `python app.py`.

# Required: NVIDIA API key with access to the Nemotron 3 Ultra private endpoint.
NVIDIA_API_KEY="nvapi-..."

# Optional. Defaults bind Gradio to localhost on port 7860.
# Set the host to 0.0.0.0 only if you intend to expose the app on your LAN.
# GRADIO_SERVER_NAME=127.0.0.1
# GRADIO_SERVER_PORT=7860
